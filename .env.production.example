# Reelpath — variables de entorno para PRODUCCIÓN (VPS + Docker Compose)
#
# Copia a .env en el servidor:  cp .env.production.example .env
#
# Solo infra + cifrado + redirect. Preferencias de producto → UI canal/org.
# API keys y YouTube Client ID/Secret → Ajustes → Secretos de plataforma.
# Guía: docs/DEPLOY.md · docs/SAAS.md

# ─── Obligatorias ─────────────────────────────────────────────────────────────
DOMAIN=app.tudominio.com
ACME_EMAIL=tu@email.com
POSTGRES_PASSWORD=cambia-esta-contraseña-segura

AUTH_REQUIRED=true
AUTH_SECRET=genera-un-secreto-aleatorio-de-al-menos-32-caracteres
NEXT_PUBLIC_AUTH_REQUIRED=true
NEXT_PUBLIC_API_URL=https://app.tudominio.com
FRONTEND_URL=https://app.tudominio.com

MOCK_EXTERNAL_APIS=false
NODE_ENV=production

# ─── Base de datos y colas ────────────────────────────────────────────────────
DATABASE_URL=postgresql://autotube:cambia-esta-contraseña-segura@postgres:5432/autotube?connection_limit=10
REDIS_URL=redis://redis:6379
STORAGE_PATH=/app/storage
API_PORT=4000

# ─── Worker / escalado ────────────────────────────────────────────────────────
WORKER_CONCURRENCY=1
WORKER_MEMORY_LIMIT=6G

# ─── Encoding FFmpeg (capacidad de la instancia) ──────────────────────────────
FFMPEG_PRESET=veryfast
FFMPEG_THREADS=2
FFMPEG_CONCURRENCY=1
# FFMPEG_CRF=20
# FFMPEG_NICE=10
FFMPEG_FORCE_CUT_TRANSITIONS=true

# ─── Storage S3 / CDN (opcional) ──────────────────────────────────────────────
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=auto
# CDN_URL=

# ─── YouTube OAuth redirect (público; Client ID/Secret en UI) ─────────────────
YOUTUBE_OAUTH_REDIRECT_URI=https://app.tudominio.com/api/integrations/youtube/callback

# ─── Admin inicial (db:seed) ──────────────────────────────────────────────────
DEFAULT_ADMIN_EMAIL=tu@email.com
DEFAULT_ADMIN_PASSWORD=cambia-esta-contraseña
# Operadores del panel /admin (coma-separados; suele incluir DEFAULT_ADMIN_EMAIL)
PLATFORM_ADMIN_EMAILS=tu@email.com
SEED_DEMO=false

# ─── Email SMTP (ver docs/EMAIL.md) ───────────────────────────────────────────
# BREVO_API_KEY=
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=Reelpath <noreply@tudominio.com>

# ─── Cifrado credenciales (obligatorio en producción) ────────────────────────
CREDENTIALS_ENCRYPTION_KEY=genera-con-openssl-rand-hex-32

# ─── Observabilidad (opcional) ───────────────────────────────────────────────
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# METRICS_BEARER_TOKEN=genera-token-largo-para-prometheus-scrape

# ─── Stripe (opcional) ────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_UNLIMITED=price_...
# STRIPE_TAX_ENABLED=false
