# Reelpath — variables de entorno para PRODUCCIÓN (VPS + Docker Compose)
#
# Copia a .env en el servidor:  cp .env.production.example .env
#
# Este archivo incluye solo lo necesario para producción. Para la lista completa
# de variables (TTS, pipeline, Stripe, SMTP…) consulta .env.example en la raíz.
# Guía de despliegue: docs/DEPLOY.md · Checklist: docs/RELEASE_CHECKLIST.md

# ─── Obligatorias ─────────────────────────────────────────────────────────────
# Dominio público (sin https://, sin barra final). DNS A/AAAA debe apuntar al VPS.
DOMAIN=app.tudominio.com
ACME_EMAIL=tu@email.com

# Contraseña de Postgres (cámbiala; se usa en docker-compose.prod.yml)
POSTGRES_PASSWORD=cambia-esta-contraseña-segura

# Auth (obligatorio en producción)
AUTH_REQUIRED=true
AUTH_SECRET=genera-un-secreto-aleatorio-de-al-menos-32-caracteres
NEXT_PUBLIC_AUTH_REQUIRED=true

# Misma URL que el dominio (un solo origen tras Caddy)
NEXT_PUBLIC_API_URL=https://app.tudominio.com
FRONTEND_URL=https://app.tudominio.com

# Desactiva mocks en producción
MOCK_EXTERNAL_APIS=false
NODE_ENV=production

# ─── Base de datos y colas (valores internos Docker; no cambiar salvo que modifiques compose) ─
# Limita conexiones Prisma por proceso (api + worker). Ajusta según réplicas y RAM.
DATABASE_URL=postgresql://autotube:cambia-esta-contraseña-segura@postgres:5432/autotube?connection_limit=10
REDIS_URL=redis://redis:6379
STORAGE_PATH=/app/storage
API_PORT=4000

# ─── Worker / escalado ────────────────────────────────────────────────────────
# Jobs concurrentes por contenedor worker (usar 1 si escalas con --scale worker=2)
WORKER_CONCURRENCY=1
# Límite RAM del contenedor worker (docker-compose.prod.yml)
WORKER_MEMORY_LIMIT=6G

# ─── Encoding FFmpeg ───────────────────────────────────────────────────────────
FFMPEG_PRESET=fast
# FFMPEG_CRF=18

# ─── Storage S3 / CDN (opcional) ──────────────────────────────────────────────
# S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com
# S3_BUCKET=reelpath-media
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=auto
# URL pública para servir media (CDN o bucket público)
# CDN_URL=https://cdn.tudominio.com
# S3_PUBLIC_URL=https://bucket.r2.dev

# ─── YouTube OAuth (plataforma) ───────────────────────────────────────────────
# Google Cloud → OAuth 2.0 → tipo "Aplicación web"
# URI de redirección autorizada:
#   https://app.tudominio.com/api/integrations/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=https://app.tudominio.com/api/integrations/youtube/callback
YOUTUBE_PRIVACY_STATUS=public

# ─── IA / TTS (al menos una para vídeos reales) ─────────────────────────────
OPENAI_API_KEY=
TTS_PROVIDER=auto
TTS_ENABLE_EDGE=true
ELEVENLABS_API_KEY=
GENERATE_DALLE_IMAGES=false

# ─── Admin inicial (creado por db:seed) ───────────────────────────────────────
DEFAULT_ADMIN_EMAIL=tu@email.com
DEFAULT_ADMIN_PASSWORD=cambia-esta-contraseña

# Seed en producción: solo planes + admin (sin org/canales demo)
SEED_DEMO=false
# SEED_ORG_SLUG=main
# SEED_ORG_NAME=Mi organización

# ─── Email SMTP (ver docs/EMAIL.md — recomendado: Brevo) ─────────────────────
# Alternativa a SMTP: clave API Brevo (Transactional → SMTP & API → API keys)
# BREVO_API_KEY=xkeysib-...
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# EMAIL_FROM=Reelpath <noreply@tudominio.com>

# ─── Cifrado credenciales (obligatorio en producción) ────────────────────────
# Genera con: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=genera-con-openssl-rand-hex-32

# ─── Observabilidad (opcional) ───────────────────────────────────────────────
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# ─── Stripe (opcional) ────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_UNLIMITED=price_...
# STRIPE_TAX_ENABLED=false
