FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
COPY packages/shared/package.json ./packages/shared/
COPY frontend/package.json ./frontend/
RUN npm install --workspace=frontend --workspace=@autotube/shared --include-workspace-root

FROM deps AS build
ARG NEXT_PUBLIC_API_URL=https://localhost
ARG NEXT_PUBLIC_AUTH_REQUIRED=true
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_AUTH_REQUIRED=$NEXT_PUBLIC_AUTH_REQUIRED
COPY packages/shared ./packages/shared
COPY frontend ./frontend
RUN npm run build -w @autotube/shared
WORKDIR /app/frontend
RUN npx next build

# next.config currently disables output:standalone — run via next start.
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./
COPY --from=build /app/packages ./packages
COPY --from=build /app/frontend ./frontend
WORKDIR /app/frontend
EXPOSE 3000
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
CMD ["npx", "next", "start", "-H", "0.0.0.0", "-p", "3000"]
