{
  "name": "@autotube/database",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "generate": "dotenv -e ../../../.env -- prisma generate",
    "migrate": "dotenv -e ../../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../../.env -- prisma migrate deploy",
    "migrate:deploy:ci": "prisma migrate deploy",
    "seed": "dotenv -e ../../../.env -- tsx prisma/seed.ts",
    "seed:ci": "tsx prisma/seed.ts",
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@autotube/config": "^0.1.0",
    "@prisma/client": "^6.3.1"
  },
  "devDependencies": {
    "bcryptjs": "^2.4.3",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
