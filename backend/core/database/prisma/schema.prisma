generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PlanDefinition {
  id                String   @id
  name              String
  description       String?
  priceMonthlyCents Int?
  stripePriceId     String?
  limits            Json
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Organization {
  id                   String    @id @default(cuid())
  name                 String
  slug                 String    @unique
  plan                 String    @default("trial")
  planLimits           Json?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  billingStatus        String?
  subscriptionRenewsAt DateTime?
  trialEndsAt          DateTime?
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  members     OrganizationMember[]
  invites     OrganizationInvite[]
  channels    Channel[]
  credentials IntegrationCredential[]
  notifications Notification[]
}

model StripeWebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  processedAt DateTime @default(now())
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  locale       String   @default("es")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships      OrganizationMember[]
  invitesSent      OrganizationInvite[] @relation("InviteSender")
  notifications    Notification[]
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model OrganizationInvite {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           String    @default("member")
  token          String    @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([token])
}

model Notification {
  id             String    @id @default(cuid())
  organizationId String
  userId         String?
  kind           String
  title          String
  message        String
  href           String
  severity       String    @default("info")
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, userId, readAt])
}

model IntegrationCredential {
  id             String   @id @default(cuid())
  organizationId String
  channelId      String?
  provider       String
  data           Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel      Channel?     @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, provider])
  @@index([organizationId, provider])
}

model Channel {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  youtubeId      String?
  niche          String
  config         Json
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipelineRuns    PipelineRun[]
  promptBindings  PromptBinding[]
  analytics       AnalyticsSnapshot[]
  credentials     IntegrationCredential[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model PipelineRun {
  id          String         @id @default(cuid())
  channelId   String
  status      String
  currentStep String?
  error       String?
  metadata    Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  completedAt DateTime?

  channel     Channel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  ideas       VideoIdea[]
  scripts     Script[]
  mediaAssets MediaAsset[]
  videos      Video[]

  @@index([channelId, status])
  @@index([createdAt])
  @@index([channelId, createdAt])
}

model VideoIdea {
  id              String   @id @default(cuid())
  pipelineRunId   String
  title           String
  hook            String
  angle           String
  targetAudience  String
  trendAlignment  Float
  viralScore      Float
  rationale       String
  isSelected      Boolean  @default(false)
  scoreBreakdown  Json?
  createdAt       DateTime @default(now())

  pipelineRun PipelineRun @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)

  @@index([pipelineRunId, viralScore])
}

model Script {
  id              String   @id @default(cuid())
  pipelineRunId   String
  title           String
  description     String
  tags            String[]
  selectedVariant Json
  alternateVariant Json?
  hookVariantUsed String   @default("A")
  createdAt       DateTime @default(now())

  pipelineRun PipelineRun @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)
}

model MediaAsset {
  id            String   @id @default(cuid())
  pipelineRunId String
  sceneIndex    Int
  type          String
  path          String
  metadata      Json?
  createdAt     DateTime @default(now())

  pipelineRun PipelineRun @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)

  @@index([pipelineRunId, sceneIndex])
}

model Video {
  id              String    @id @default(cuid())
  pipelineRunId   String
  channelId       String
  title           String
  description     String
  tags            String[]
  filePath        String
  thumbnailPath   String?
  format          String
  aspectRatio     String
  durationSec     Float
  reviewStatus        String    @default("pending")
  scheduledPublishAt  DateTime?
  youtubeVideoId      String?
  publishedAt         DateTime?
  qualityScore        Float?
  qualityReport       Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  pipelineRun PipelineRun         @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)
  analytics   AnalyticsSnapshot[]
  clips       VideoClip[]

  @@index([channelId, reviewStatus])
}

model VideoClip {
  id            String    @id @default(cuid())
  videoId       String
  pipelineRunId String
  partIndex     Int
  title         String
  filePath      String
  thumbnailPath String?
  durationSec   Float
  aspectRatio   String    @default("9:16")
  platform      String    @default("short_source")
  publishStatus String    @default("pending")
  externalId    String?
  scheduledPublishAt DateTime?
  publishedAt   DateTime?
  error         String?
  createdAt     DateTime  @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId, partIndex])
  @@index([pipelineRunId])
}

model PromptVersion {
  id          String   @id @default(cuid())
  type        String
  version     String
  name        String
  template    String
  variables   String[]
  isActive    Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())

  variants    PromptVariant[]
  bindings    PromptBinding[]
  abResults   PromptAbResult[]

  @@unique([type, version])
  @@index([type, isActive])
}

model PromptVariant {
  id              String   @id @default(cuid())
  promptVersionId String
  variantKey      String
  templateOverride String?
  weight          Float    @default(0.5)
  createdAt       DateTime @default(now())

  promptVersion PromptVersion @relation(fields: [promptVersionId], references: [id], onDelete: Cascade)
  abResults     PromptAbResult[]

  @@unique([promptVersionId, variantKey])
}

model PromptBinding {
  id              String   @id @default(cuid())
  channelId       String
  promptVersionId String
  promptType      String
  createdAt       DateTime @default(now())

  channel       Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  promptVersion PromptVersion @relation(fields: [promptVersionId], references: [id], onDelete: Cascade)

  @@unique([channelId, promptType])
}

model PromptAbResult {
  id              String   @id @default(cuid())
  promptVersionId String
  variantId       String
  pipelineRunId   String?
  metric          String
  value           Float
  createdAt       DateTime @default(now())

  promptVersion PromptVersion @relation(fields: [promptVersionId], references: [id], onDelete: Cascade)
  variant       PromptVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model AnalyticsSnapshot {
  id                     String   @id @default(cuid())
  channelId              String
  videoId                String?
  views                  Int      @default(0)
  ctr                    Float    @default(0)
  retention              Float    @default(0)
  likes                  Int      @default(0)
  comments               Int      @default(0)
  watchTimeMinutes       Float    @default(0)
  averageViewDurationSec Float    @default(0)
  snapshotAt             DateTime @default(now())
  raw                    Json?

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  video   Video?  @relation(fields: [videoId], references: [id], onDelete: SetNull)

  @@index([channelId, snapshotAt])
  @@index([videoId, snapshotAt])
}

model TrendSnapshot {
  id        String   @id @default(cuid())
  niche     String
  topic     String
  score     Float
  source    String   @default("simulated")
  fetchedAt DateTime @default(now())

  @@index([niche, fetchedAt])
}

model VideoTemplateRecord {
  id          String   @id
  name        String
  config      Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
