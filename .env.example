# Reelpath — plantilla de variables de entorno (desarrollo local)
#
# Estructura:
#   .env.example              ← este archivo (infra + cifrado + redirect)
#   .env.production.example   ← variante mínima para VPS/Docker
#   .env                      ← tu archivo real (gitignored); NUNCA commitear
#
# Preferencias de PRODUCTO (TTS, escenas, imágenes IA, voces, review, Shorts…)
# viven en BD: Channel.config (canal) → Organization (workspace) → defaults de código.
#
# API keys y YouTube Client ID/Secret: Ajustes → Secretos de plataforma (BD cifrada).
# NO las pongas aquí. Ver docs/SAAS.md.
#
# Uso: cp .env.example .env
# Guías: docs/DEPLOY.md · docs/BILLING.md · docs/EMAIL.md

# Redis
REDIS_URL=redis://localhost:6379

# ─── Worker / encoding (capacidad de la instancia) ─────────────────────────────
WORKER_CONCURRENCY=1
FFMPEG_PRESET=veryfast
# FFMPEG_CRF=18
FFMPEG_THREADS=2
FFMPEG_CONCURRENCY=1
# FFMPEG_NICE=10
# FFMPEG_SCALE_FLAGS=bicubic
# FFMPEG_ENABLE_FILM_GRAIN=false
# FFMPEG_FORCE_CUT_TRANSITIONS=true

# Database
DATABASE_URL=postgresql://autotube:autotube@localhost:5433/autotube

# DeepSeek (no secreto; el API key va en Secretos de plataforma)
# Modelos actuales: deepseek-v4-pro (default) | deepseek-v4-flash (más barato)
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-pro

# App
API_PORT=4000
FRONTEND_URL=http://localhost:3000
STORAGE_PATH=./storage

# YouTube: solo redirect / refresh token de desarrollo.
# Client ID + Secret → Ajustes → Secretos de plataforma.
# YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:4000/api/integrations/youtube/callback
# YOUTUBE_REFRESH_TOKEN=   # solo dev legacy; en prod usa OAuth por canal

# Solo desarrollo local sin claves (docker-compose.yml). En Atlas/prod DEBE ser false.
# Con false y sin DeepSeek/OpenAI el pipeline FALLA (no inventa vídeos mock).
MOCK_EXTERNAL_APIS=true

# ─── Multi-tenant auth ─────────────────────────────────────────────────────────
# La API exige sesión en rutas de datos aunque AUTH_REQUIRED=false (UI/registro).
AUTH_REQUIRED=true
AUTH_SECRET=cambia-este-secreto-local-minimo-32-caracteres
DEFAULT_ADMIN_EMAIL=adripardo72@gmail.com
DEFAULT_ADMIN_PASSWORD=changeme
# Operadores del panel /admin (emails separados por comas; case-insensitive)
PLATFORM_ADMIN_EMAILS=adripardo72@gmail.com
NEXT_PUBLIC_AUTH_REQUIRED=true
NEXT_PUBLIC_API_URL=http://localhost:4000

# Token opcional para /metrics y /health/extended (además de admin)
# METRICS_BEARER_TOKEN=

# ─── Producción (VPS + Docker) — ver .env.production.example ─────────────────
# DOMAIN=app.tudominio.com
# YOUTUBE_OAUTH_REDIRECT_URI=https://app.tudominio.com/api/integrations/youtube/callback
# POSTGRES_PASSWORD=
# ACME_EMAIL=

# ─── Stripe (ver docs/BILLING.md) ─────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_UNLIMITED=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_TAX_ENABLED=false

# ─── Email SMTP (ver docs/EMAIL.md) ───────────────────────────────────────────
# BREVO_API_KEY=
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# EMAIL_FROM=Reelpath <noreply@tudominio.com>

# ─── Cifrado credenciales (BYOK org + secretos de plataforma) ─────────────────
# Obligatorio para guardar secretos (sin esto falla el cifrado).
CREDENTIALS_ENCRYPTION_KEY=   # openssl rand -hex 32
# Solo emergencias/migración: ALLOW_PLAINTEXT_CREDENTIALS=true

# ─── Stock B-roll (opcionales; Pexels también vía Secretos de plataforma) ─────
# PIXABAY_API_KEY=   # https://pixabay.com/api/docs/
# COVERR_API_KEY=    # https://coverr.co/developers
