# Reelpath — plantilla de variables de entorno (desarrollo local)
#
# Estructura de archivos en la raíz del repo:
#   .env.example              ← fuente de verdad (este archivo): todas las variables documentadas
#   .env.production.example   ← variante mínima para VPS/Docker (sin secretos de ejemplo)
#   .env                      ← tu archivo real (gitignored); NUNCA commitear
#
# Uso rápido:
#   Local:  cp .env.example .env
#   Prod:   cp .env.production.example .env   (ver docs/DEPLOY.md)
#
# Integraciones opcionales (Stripe, SMTP, Pexels…) están comentadas más abajo.
# Guías: docs/DEPLOY.md · docs/BILLING.md · docs/EMAIL.md · docs/RELEASE_CHECKLIST.md

# Redis
REDIS_URL=redis://localhost:6379

# ─── Worker / encoding ─────────────────────────────────────────────────────────
# Jobs BullMQ concurrentes por proceso worker (default: 2 dev, 1 prod)
WORKER_CONCURRENCY=2
# Preset x264: medium (dev) | fast (prod). Override con FFMPEG_PRESET=fast|medium|slow…
FFMPEG_PRESET=medium
# CRF calidad vídeo (default 18; menor = mejor calidad)
# FFMPEG_CRF=18

# Database
DATABASE_URL=postgresql://autotube:autotube@localhost:5433/autotube

# ─── Text-to-Speech (TTS) ─────────────────────────────────────────────────────
# Provider priority when TTS_PROVIDER=auto (recommended):
#   1. ElevenLabs  — best Spanish quality (requires ELEVENLABS_API_KEY)
#   2. Edge TTS    — free Microsoft voices, good Spanish (TTS_ENABLE_EDGE=true)
#   3. OpenAI TTS  — fallback (requires OPENAI_API_KEY)
#   4. Silent mock — when MOCK_EXTERNAL_APIS=true or no provider available
#
# Set TTS_PROVIDER to force a single provider: elevenlabs | edge | openai | mock

TTS_PROVIDER=auto
TTS_ENABLE_EDGE=true

# ElevenLabs (recommended for Spanish Shorts — get key at https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=
# Matilda — multilingual premade voice, natural Spanish
ELEVENLABS_VOICE_ID=eHAEFkimnYz57pupUMcq
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_LANGUAGE_CODE=es
ELEVENLABS_STABILITY=0.45
ELEVENLABS_SIMILARITY=0.8
ELEVENLABS_STYLE=0.15

# Edge TTS — free Microsoft voices (no API key needed)
EDGE_TTS_VOICE=es-ES-ElviraNeural
EDGE_TTS_RATE=+0%
EDGE_TTS_VOLUME=+0%
EDGE_TTS_PITCH=+0Hz

# OpenAI TTS — fallback only (Spanish quality is limited vs ElevenLabs/Edge)
OPENAI_API_KEY=
OPENAI_TTS_MODEL=tts-1-hd
OPENAI_TTS_VOICE=nova
OPENAI_TTS_SPEED=1.0
OPENAI_IMAGE_MODEL=gpt-image-1

# Cost control (recommended defaults)
# Scene images: false = procedural visuals (free). true = OpenAI images (~$0.04/image).
# Model: gpt-image-1 (default) | dall-e-3 — your API key may only support gpt-image-1
GENERATE_DALLE_IMAGES=false
# Script LLM — production model (default gpt-4o-mini). Dev uses OPENAI_MODEL_DEV when SCRIPT_DEV_MODE=true or NODE_ENV=development.
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_DEV=gpt-4o-mini
# SCRIPT_DEV_MODE=false — en development (NODE_ENV) usa OPENAI_MODEL_DEV y sin fallback monolithic
SCRIPT_DEV_MODE=false
# Solo en producción si chunked falla por error de red (no validación): SCRIPT_MONOLITHIC_FALLBACK=true
SCRIPT_MONOLITHIC_FALLBACK=false
PIPELINE_MAX_SCENES_SHORT=3
# Long-form: mínimo 8 minutos (~1080 palabras). Escenas flexibles 12-20.
PIPELINE_MIN_SCENES_LONG=12
PIPELINE_MAX_SCENES_LONG=20
OPENAI_MAX_TOKENS=3000
OPENAI_MAX_TOKENS_LONG=8000

# App — no fijes NODE_ENV aquí: Next.js y npm lo establecen en build/start.
# Si NODE_ENV=development en .env, `npm run build -w frontend` fallará.
API_PORT=4000
FRONTEND_URL=http://localhost:3000
STORAGE_PATH=./storage

# ─── Publishing ───────────────────────────────────────────────────────────────
# YouTube: full video upload (requires OAuth refresh token)
# 1. Create project at https://console.cloud.google.com
# 2. Enable YouTube Data API v3 and YouTube Analytics API
# 3. OAuth consent + credentials (Web app) — scopes: youtube.upload, youtube, yt-analytics.readonly
# 4. Obtain refresh token (one-time OAuth flow) and paste below, or connect per-channel in the UI
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY_STATUS=public

# YouTube Shorts: duración máxima por clip vertical (segundos, default 60)
SHORTS_CLIP_MAX_SEC=60

# Pipeline defaults
DEFAULT_REVIEW_REQUIRED=false
# Set to false + at least one TTS provider for real audio
# Para probar pipelines sin gastar en OpenAI: MOCK_EXTERNAL_APIS=true (guiones mock locales, $0)
MOCK_EXTERNAL_APIS=true

# ─── Multi-tenant auth (Phase 1 SaaS) ─────────────────────────────────────────
# AUTH_REQUIRED=false keeps local dev working without login
AUTH_REQUIRED=false
# Required in production when AUTH_REQUIRED=true (min 32 chars recommended)
AUTH_SECRET=
DEFAULT_ADMIN_EMAIL=adripardo72@gmail.com
DEFAULT_ADMIN_PASSWORD=changeme

# Frontend (Next.js) — mirror AUTH_REQUIRED for route protection
NEXT_PUBLIC_AUTH_REQUIRED=false
# En producción con un solo dominio: https://app.tudominio.com (ver docs/DEPLOY.md)
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── Producción (VPS + Docker) — ver .env.production.example y docs/DEPLOY.md ─
# DOMAIN=app.tudominio.com
# YOUTUBE_OAUTH_REDIRECT_URI=https://app.tudominio.com/api/integrations/youtube/callback
# POSTGRES_PASSWORD=
# ACME_EMAIL=

# ─── Stripe (billing — ver docs/BILLING.md) ───────────────────────────────────
# 1. Clave secreta de test: https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY=sk_test_REEMPLAZA
# 2. Crear productos y precios: npm run stripe:setup
#    (Creator 79 EUR/mes, Pro 149 EUR/mes, Studio 399 EUR/mes)
# STRIPE_PRICE_STARTER=price_REEMPLAZA_CREATOR_79EUR
# STRIPE_PRICE_PRO=price_REEMPLAZA_PRO_149EUR
# STRIPE_PRICE_UNLIMITED=price_REEMPLAZA_STUDIO_399EUR
# 3. Webhook local: stripe listen --forward-to localhost:4000/api/billing/webhook
# STRIPE_WEBHOOK_SECRET=whsec_REEMPLAZA
# STRIPE_TAX_ENABLED=false
# Verificar: npm run stripe:verify

# ─── Email transaccional SMTP (ver docs/EMAIL.md) ────────────────────────────
# Recomendado para España/EU: Brevo (ex-Sendinblue) — gratis ~300 emails/día
# Alternativa a SMTP: clave API Brevo (Transactional → SMTP & API → API keys)
# BREVO_API_KEY=xkeysib-...
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=tu-login-smtp@brevo.com
# SMTP_PASS=xsmtpsib-...
# SMTP_SECURE=false
# EMAIL_FROM=Reelpath <noreply@tudominio.com>

# ─── Stock b-roll (opcional) ───────────────────────────────────────────────────
# Clave gratuita en https://www.pexels.com/api/ — permite buscar fotos y vídeos stock.
# PEXELS_API_KEY=

# ─── Cifrado credenciales OAuth por canal ────────────────────────────────────
# CREDENTIALS_ENCRYPTION_KEY=   # openssl rand -hex 32
