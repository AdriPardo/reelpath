# Atlas = producción. Solo operación; flags (mocks/auth) los fija docker-compose.atlas.yml.
DOMAIN=reelpath.atlasops.dev
POSTGRES_PASSWORD=autotube
PLATFORM_ADMIN_EMAILS=
WORKER_CONCURRENCY=1

# AUTH_SECRET y CREDENTIALS_ENCRYPTION_KEY los inyecta Atlas (envFrom / secretos del proyecto).
# LLM / TTS / YouTube OAuth app → Ajustes → Secretos de plataforma (BD), no .env.
